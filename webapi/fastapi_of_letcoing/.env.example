# 复制为 .env.production；Worker 使用独立的 .env.worker.production。
# 密钥需分别生成，不要使用下面占位值。
APP_ENV=production
JWT_SECRET_KEY=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET
FLASK_SECRET_KEY=REPLACE_WITH_ANOTHER_RANDOM_SECRET
FRONTEND_URL=https://oj.example.com
PUBLIC_BACKEND_URL=https://oj.example.com/api
ALLOWED_ORIGINS=https://oj.example.com
TRUSTED_PROXY_HOPS=1
DATABASE_URL=postgresql://letcoding:CHANGE_ME@database.internal:5432/letcoding?sslmode=verify-full
DB_MAX_CONNECTIONS=8
DB_STATEMENT_TIMEOUT_MS=15000
REDIS_HOST=redis.internal
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_DB=0
WEB_WORKERS=2
WEB_THREADS=4
METRICS_TOKEN=REPLACE_WITH_RANDOM_METRICS_TOKEN
UPLOAD_DIR=/var/lib/letcoding/uploads
# 生产使用自己管理的 Judge0 服务；需禁网、限制 CPU/内存/输出。
JUDGE0_BASE_URL=http://judge0.internal:2358
# OIDC_PROVIDER_NAMES、GITHUB_CLIENT_ID、GITHUB_CLIENT_SECRET 等按现有提供商配置。
# OIDC_PROVIDER_NAMES=iOSClub
# IOSCLUB_ISSUER=https://your-oidc-provider-domain.com
# IOSCLUB_CLIENT_ID=your-iosclub-client-id
# IOSCLUB_CLIENT_SECRET=your-iosclub-client-secret
# IOSCLUB_SCOPE=openid profile role
# IOSCLUB_REDIRECT_URI=https://oj.example.com/api/auth/callback/iOSClub

# API 与所有 Worker 必须使用同一不可变判题镜像；仅作题包元数据，不给 API Docker 权限。
JUDGE_SANDBOX_IMAGE=registry.example.com/letcoding-sandbox@sha256:REPLACE_WITH_IMAGE_DIGEST
# Worker 专用：每个实例一个执行槽位；不同实例配置不同物理 CPU。
JUDGE_WORKER_POOL=contest
JUDGE_CPUSET=0
